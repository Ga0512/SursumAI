#!/usr/bin/env python3
"""SursumAI CLI — daemon manager + thin wrapper over the central API.

Commands:
  sursumai               start the 3 processes (if needed) and open the browser
  sursumai --ui          same as above (explicit, used by desktop shortcut)
  sursumai status        show running state of web/central/agent
  sursumai restart       stop and start the 3 processes
  sursumai stop          stop the 3 processes (model deploys keep running)
  sursumai version       show the installed version
  sursumai login [email] [password]   store a token for API commands
  sursumai whoami        show who is logged in
  sursumai logout        remove the stored token
  sursumai list          table of deploys
  sursumai deploy <model> [--runtime vllm|llama] [--gpus N] [--no-wait]
  sursumai keys          list account API keys (--create NAME, --revoke ID)
  sursumai logs <id> [--tail N] [--follow]
  sursumai chat <id|pool:name> [prompt]
  sursumai pools         table of pools
  sursumai destroy <id> [--yes]
  sursumai update [--yes] [--version vX.Y.Z]
  sursumai service [install|uninstall|status]   run it as a service
  sursumai uninstall [--yes]

Every command exits non-zero on failure, and prints a human sentence rather
than a traceback. Add --json to the read commands for machine-readable output.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

SURSUMAI_ROOT = Path(__file__).resolve().parent.parent.parent

# The three ports: 3000 / 8001 / 8010 by default, and the host's decision when
# SursumAI runs as a service (SURSUMAI_WEB_PORT, SURSUMAI_CENTRAL_PORT,
# SURSUMAI_AGENT_PORT). core/ports.py is where they are read and checked.
sys.path.insert(0, str(SURSUMAI_ROOT))
try:
    from core import ports as _ports
    WEB_PORT, CENTRAL_PORT, AGENT_PORT = _ports.WEB_PORT, _ports.CENTRAL_PORT, _ports.AGENT_PORT
except ImportError:          # the CLI must still answer before the code is there
    WEB_PORT, CENTRAL_PORT, AGENT_PORT = 3000, 8001, 8010

CENTRAL_URL = os.environ.get("SURSUMAI_CENTRAL", f"http://localhost:{CENTRAL_PORT}")
WEB_URL = os.environ.get("SURSUMAI_WEB", f"http://localhost:{WEB_PORT}")
AGENT_URL = os.environ.get("AGENT_URL", f"http://localhost:{AGENT_PORT}")
# Loopback unless the user opts in; matches start.sh.
BIND = os.environ.get("SURSUMAI_BIND", "127.0.0.1")

CONFIG_DIR = Path.home() / ".config" / "sursumai"
AUTH_FILE = CONFIG_DIR / "auth.json"
LOG_DIR = Path(os.environ.get("SURSUMAI_LOG_DIR", "/tmp/opencode"))
RUNNING_VERSION = LOG_DIR / "running-version"   # what the running processes were started from

PORT_INFO = {
    "web": {"port": WEB_PORT, "url": WEB_URL, "pattern": "web/server.py"},
    "central": {"port": CENTRAL_PORT, "url": CENTRAL_URL, "pattern": "uvicorn central.app"},
    "agent": {"port": AGENT_PORT, "url": AGENT_URL, "pattern": "uvicorn agent.app"},
}

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2


class CliError(Exception):
    """Anything the user can act on. Never carries a traceback."""


def _utf8_output() -> None:
    """Never die printing a status line: the CLI uses ✓/✗ and stdout may be a
    log file or a console whose locale cannot encode them."""
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass


# ---------- human helpers ----------

def ok(msg: str) -> None:
    print(f"✓ {msg}")


def warn(msg: str) -> None:
    print(f"! {msg}")


def die(msg: str, code: int = EXIT_ERROR) -> None:
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(code)


def emit(data, as_json: bool) -> bool:
    """Print JSON and report whether that was the whole job."""
    if as_json:
        print(json.dumps(data, indent=2))
    return as_json


# ---------- http ----------

def _http(method: str, path: str, body: dict | None = None,
          token: str | None = None, timeout: float = 30.0) -> tuple[int, dict]:
    url = CENTRAL_URL.rstrip("/") + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return resp.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = _error_detail(e)
        if e.code == 401:
            raise CliError("login expired — run `sursumai login`")
        if e.code == 404:
            raise CliError(detail or "not found")
        raise CliError(detail or f"server error ({e.code})")
    except urllib.error.URLError:
        raise CliError("can't reach SursumAI central — is it running? run `sursumai` first")
    except TimeoutError:
        raise CliError("the server took too long to answer")
    except json.JSONDecodeError:
        raise CliError("the server sent a reply this version cannot read")


def _error_detail(e: urllib.error.HTTPError) -> str:
    try:
        body = json.loads(e.read().decode() or "{}")
        if isinstance(body, dict):
            detail = body.get("detail")
            if isinstance(detail, str):
                return detail
            if isinstance(detail, list):
                msgs = [d.get("msg", "") for d in detail if isinstance(d, dict)]
                if msgs:
                    return ", ".join(msgs)
        return str(body)
    except Exception:
        return ""


def _get(path: str, token: str | None = None) -> dict:
    return _http("GET", path, token=token)[1]


# ---------- auth ----------

def _load_token() -> str:
    if not AUTH_FILE.exists():
        raise CliError("not logged in — run `sursumai login`")
    try:
        token = json.loads(AUTH_FILE.read_text()).get("token", "")
    except (json.JSONDecodeError, OSError):
        raise CliError("stored login is corrupted — run `sursumai login`")
    if not token:
        raise CliError("stored login is empty — run `sursumai login`")
    return token


def _save_token(token: str) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    # create 0600 from the start — the token is a bearer credential
    fd = os.open(AUTH_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, json.dumps({"token": token}).encode())
    finally:
        os.close(fd)


def _resolve_deploy(deploy_id: str, token: str) -> dict:
    """Accept a full id or any unambiguous prefix, the way git does."""
    try:
        return _get(f"/deploys/{deploy_id}", token)
    except CliError:
        pass
    matches = [d for d in _get("/deploys", token) if d["id"].startswith(deploy_id)]
    if not matches:
        raise CliError(f"no deploy matching '{deploy_id}' — run `sursumai list`")
    if len(matches) > 1:
        ids = ", ".join(d["id"][:12] for d in matches)
        raise CliError(f"'{deploy_id}' matches several deploys: {ids}")
    return matches[0]


# ---------- launcher ----------

def _port_open(port: int, timeout: float = 1.5) -> bool:
    import socket

    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def _down() -> list[str]:
    return [n for n, i in PORT_INFO.items() if not _port_open(i["port"])]


def _venv_python() -> Path:
    return SURSUMAI_ROOT / ".venv" / "bin" / "python"


def _service_commands() -> dict[str, list[str]]:
    """How each of the three processes is started, in one place.

    `sursumai` and `sursumai service` both read this. A service file that
    drifts from how the CLI actually starts things is the worst kind of bug
    here: it works until the day it is the only thing starting them.
    """
    py = str(_venv_python())
    return {
        "agent": [py, "-m", "uvicorn", "agent.app:app",
                  "--host", BIND, "--port", str(AGENT_PORT)],
        "central": [py, "-m", "uvicorn", "central.app:app",
                    "--host", BIND, "--port", str(CENTRAL_PORT)],
        "web": [py, "web/server.py", "--port", str(WEB_PORT), "--host", BIND],
    }


def _start_processes() -> None:
    py = _venv_python()
    if not py.exists():
        print("first run — preparing the environment…")
        result = subprocess.run(["bash", str(SURSUMAI_ROOT / "setup.sh")])
        if result.returncode != 0:
            raise CliError("setup failed — see the messages above")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    # reinstalling or updating with the app open replaces the code on disk but
    # not the processes: without this, `sursumai` saw them up and kept serving
    # the old version as if nothing had changed
    running = RUNNING_VERSION.read_text().strip() if RUNNING_VERSION.exists() else None
    if len(_down()) < len(PORT_INFO) and running != _local_version():
        print(f"SursumAI was updated to {_local_version()} — restarting it…")
        cmd_stop(argparse.Namespace())
    env = {**os.environ, "AGENT_URL": AGENT_URL, "SURSUMAI_BIND": BIND}

    commands = _service_commands()
    for name, info in PORT_INFO.items():
        if _port_open(info["port"]):
            continue
        with open(LOG_DIR / f"{name}.log", "ab") as logf:
            subprocess.Popen(
                commands[name], cwd=SURSUMAI_ROOT, env=env,
                stdout=logf, stderr=subprocess.STDOUT, start_new_session=True,
            )

    # the first start after an install compiles every module and fetches the
    # Pro module: well past 20 s on a laptop, which reported a failure for
    # services that came up a few seconds later
    deadline = time.time() + 90
    if _down():
        print("starting SursumAI…")
    while time.time() < deadline and _down():
        time.sleep(0.5)
    missing = _down()
    if missing:
        for name in missing:
            warn(f"{name} didn't come up — see {LOG_DIR}/{name}.log")
        raise CliError("SursumAI did not start completely")
    RUNNING_VERSION.write_text(_local_version())


def _open_browser(url: str) -> None:
    if sys.platform == "win32" or os.environ.get("WSL_DISTRO_NAME"):
        subprocess.Popen(["cmd.exe", "/c", "start", "", url],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif sys.platform == "darwin":
        subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        try:
            if subprocess.run(["xdg-open", url], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode != 0:
                warn(f"open the browser at {url}")
        except FileNotFoundError:
            warn(f"open the browser at {url}")


def cmd_launch(args: argparse.Namespace) -> None:
    _start_processes()
    print(f"SursumAI is up: {WEB_URL}")
    if BIND not in ("127.0.0.1", "localhost"):
        warn(f"listening on {BIND} — reachable from the network")
    _open_browser(WEB_URL)


def cmd_status(args: argparse.Namespace) -> None:
    rows = {name: ("running" if _port_open(info["port"]) else "stopped")
            for name, info in PORT_INFO.items()}
    if emit({"services": rows, "version": _local_version()}, getattr(args, "json", False)):
        return
    for name, info in PORT_INFO.items():
        print(f"{name:8} {rows[name]:8} {info['url']}")
    if any(v == "stopped" for v in rows.values()):
        print("run `sursumai` to start everything")
        sys.exit(EXIT_ERROR)


def cmd_stop(args: argparse.Namespace) -> None:
    for info in PORT_INFO.values():
        subprocess.run(["pkill", "-f", info["pattern"]],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1)
    ok("stopped web, central and agent (model deploys keep running)")


def cmd_restart(args: argparse.Namespace) -> None:
    cmd_stop(args)
    _start_processes()
    ok(f"restarted — {WEB_URL}")


def cmd_version(args: argparse.Namespace) -> None:
    print(f"sursumai {_local_version()}")


# ---------- running as a service ----------
#
# Nothing kept SursumAI running. A reboot stopped it, a crash stopped it, and
# `sursumai update` stops the three processes and ends by telling you to start
# them again — so the API was down from the update until somebody noticed. For
# anything anyone depends on, that is the first thing to fix.
#
# Deliberately NOT part of install.sh: the installer is the one file here that
# can break an install for everybody, launchd and systemd cannot be tested
# from the same machine, and a service is a decision about the host, not
# something to do to someone silently. It is a command you run on purpose.
#
# User-level on both platforms, so there is no sudo and nothing lands outside
# $HOME. Three units, one per process, because a supervisor supervises one
# process: a single unit that starts three and exits gets you "survives a
# reboot" but not "comes back after a crash", which is half the point.

SERVICE_LABEL = "com.sursumai"
# Config is baked into the unit, which is exactly the point: SURSUMAI_BIND as
# an `export` in one shell is how an exposed install silently goes back to
# loopback after a reboot. Secrets are not: AGENT_KEY lives in
# ~/.sursumai/agent.key at 0600 and is read from there, and writing it into a
# unit file would be a second copy for no reason.
_SECRET_HINTS = ("KEY", "TOKEN", "SECRET", "PASSWORD")


def _service_env() -> dict[str, str]:
    """The SURSUMAI_* configuration this machine is currently running with."""
    env = {"SURSUMAI_BIND": BIND, "AGENT_URL": AGENT_URL}
    for name, value in os.environ.items():
        if not name.startswith("SURSUMAI_") or not value:
            continue
        if any(hint in name.upper() for hint in _SECRET_HINTS):
            continue
        env[name] = value
    return env


def _is_mac() -> bool:
    return sys.platform == "darwin"


def _launchd_dir() -> Path:
    return Path.home() / "Library" / "LaunchAgents"


def _systemd_dir() -> Path:
    return Path.home() / ".config" / "systemd" / "user"


def _plist(name: str, command: list[str], env: dict[str, str]) -> str:
    def esc(text: str) -> str:
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))

    args = "\n".join(f"      <string>{esc(a)}</string>" for a in command)
    variables = "\n".join(f"      <key>{esc(k)}</key><string>{esc(v)}</string>"
                          for k, v in sorted(env.items()))
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>{SERVICE_LABEL}.{name}</string>
    <key>ProgramArguments</key>
    <array>
{args}
    </array>
    <key>WorkingDirectory</key><string>{esc(str(SURSUMAI_ROOT))}</string>
    <key>EnvironmentVariables</key>
    <dict>
{variables}
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>{esc(str(LOG_DIR / f"{name}.log"))}</string>
    <key>StandardErrorPath</key><string>{esc(str(LOG_DIR / f"{name}.log"))}</string>
  </dict>
</plist>
"""


def _unit(name: str, command: list[str], env: dict[str, str]) -> str:
    import shlex

    environment = "\n".join(f"Environment={k}={v}" for k, v in sorted(env.items()))
    # After= is ordering only, not a dependency: all three retry, and a hard
    # requirement would mean one failing unit keeps the others down
    after = "After=sursumai-agent.service" if name == "central" else ""
    return f"""[Unit]
Description=SursumAI {name}
{after}

[Service]
Type=simple
WorkingDirectory={SURSUMAI_ROOT}
{environment}
ExecStart={shlex.join(command)}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
"""


def _run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess:
    done = subprocess.run(cmd, capture_output=True, text=True)
    if check and done.returncode != 0:
        raise CliError(f"`{' '.join(cmd)}` failed: "
                       f"{(done.stderr or done.stdout).strip() or done.returncode}")
    return done


def _service_install() -> None:
    if sys.platform == "win32":
        raise CliError("run this inside WSL, not Windows — the services are Linux processes")
    if not _venv_python().exists():
        raise CliError("run `sursumai` once first, so the environment exists")
    env = _service_env()
    commands = _service_commands()
    LOG_DIR.mkdir(parents=True, exist_ok=True)

    if _is_mac():
        target = _launchd_dir()
        target.mkdir(parents=True, exist_ok=True)
        for name, command in commands.items():
            path = target / f"{SERVICE_LABEL}.{name}.plist"
            path.write_text(_plist(name, command, env), encoding="utf-8")
            path.chmod(0o600)
            label = f"{SERVICE_LABEL}.{name}"
            domain = f"gui/{os.getuid()}"
            # bootout first so a reinstall replaces the running job instead of
            # failing with "service already loaded"
            _run(["launchctl", "bootout", f"{domain}/{label}"])
            done = _run(["launchctl", "bootstrap", domain, str(path)])
            if done.returncode != 0:
                # bootstrap/bootout is the modern pair; older macOS only has
                # load/unload, and this has to work on both
                _run(["launchctl", "unload", str(path)])
                _run(["launchctl", "load", "-w", str(path)], check=True)
        ok("installed as a launchd service — it starts at login and restarts on crash")
        print(f"  files: {target}/{SERVICE_LABEL}.*.plist")
        print("  stop it with `sursumai service uninstall`")
        return

    if not _which("systemctl"):
        raise CliError("no systemctl here — this needs systemd (or macOS launchd)")
    target = _systemd_dir()
    target.mkdir(parents=True, exist_ok=True)
    for name, command in commands.items():
        path = target / f"sursumai-{name}.service"
        path.write_text(_unit(name, command, env), encoding="utf-8")
        path.chmod(0o600)
    _run(["systemctl", "--user", "daemon-reload"], check=True)
    units = [f"sursumai-{n}.service" for n in commands]
    _run(["systemctl", "--user", "enable", "--now", *units], check=True)
    ok("installed as a systemd user service — it restarts on crash")
    print(f"  files: {target}/sursumai-*.service")
    # without linger a user service dies at logout, which is not what anyone
    # installing a service meant, and it is not something we can set for them
    if _run(["loginctl", "show-user", str(os.getuid()), "-p", "Linger"]) \
            .stdout.strip() != "Linger=yes":
        warn("to survive logout and reboot on a server, also run: "
             f"sudo loginctl enable-linger {os.environ.get('USER', '$USER')}")
    print("  stop it with `sursumai service uninstall`")


def _service_uninstall() -> None:
    names = list(_service_commands())
    if _is_mac():
        domain = f"gui/{os.getuid()}"
        for name in names:
            path = _launchd_dir() / f"{SERVICE_LABEL}.{name}.plist"
            _run(["launchctl", "bootout", f"{domain}/{SERVICE_LABEL}.{name}"])
            _run(["launchctl", "unload", str(path)])
            path.unlink(missing_ok=True)
        ok("launchd service removed (the processes it started were stopped)")
        return
    if not _which("systemctl"):
        raise CliError("no systemctl here — nothing to remove")
    units = [f"sursumai-{n}.service" for n in names]
    _run(["systemctl", "--user", "disable", "--now", *units])
    for name in names:
        (_systemd_dir() / f"sursumai-{name}.service").unlink(missing_ok=True)
    _run(["systemctl", "--user", "daemon-reload"])
    ok("systemd service removed (the processes it started were stopped)")


def _service_status(as_json: bool) -> None:
    names = list(_service_commands())
    if _is_mac():
        installed = {n: (_launchd_dir() / f"{SERVICE_LABEL}.{n}.plist").exists()
                     for n in names}
        listed = _run(["launchctl", "list"]).stdout
        loaded = {n: f"{SERVICE_LABEL}.{n}" in listed for n in names}
        kind = "launchd"
    else:
        installed = {n: (_systemd_dir() / f"sursumai-{n}.service").exists() for n in names}
        loaded = {n: _run(["systemctl", "--user", "is-active",
                           f"sursumai-{n}.service"]).stdout.strip() == "active"
                  for n in names}
        kind = "systemd"
    rows = {n: {"installed": installed[n], "active": loaded[n]} for n in names}
    if emit({"manager": kind, "services": rows}, as_json):
        return
    if not any(installed.values()):
        print(f"not installed as a {kind} service — "
              "`sursumai service install` sets it up")
        return
    for name in names:
        state = "active" if loaded[name] else "inactive"
        print(f"{name:8} {'installed' if installed[name] else 'missing':10} {state}")


def cmd_service(args: argparse.Namespace) -> None:
    action = args.action
    if action == "install":
        _service_install()
    elif action == "uninstall":
        _service_uninstall()
    else:
        _service_status(getattr(args, "json", False))


def _which(name: str) -> str | None:
    import shutil

    return shutil.which(name)


# ---------- api commands ----------

def cmd_login(args: argparse.Namespace) -> None:
    email = args.email or input("email: ").strip()
    password = args.password or getpass.getpass("password: ")
    if not email or not password:
        raise CliError("email and password are required")
    _, data = _http("POST", "/auth/login", {"email": email, "password": password})
    _save_token(data["token"])
    ok(f"logged in as {data['user']['email']}")


def cmd_whoami(args: argparse.Namespace) -> None:
    user = _get("/auth/me", _load_token())
    if emit(user, getattr(args, "json", False)):
        return
    print(f"{user.get('name', '')} <{user['email']}>")


def cmd_logout(args: argparse.Namespace) -> None:
    token = None
    try:
        token = _load_token()
    except CliError:
        pass
    if token:
        try:
            _http("POST", "/auth/logout", {}, token)  # invalidate server-side too
        except CliError:
            pass
    if AUTH_FILE.exists():
        AUTH_FILE.unlink()
    ok("logged out")


def cmd_list(args: argparse.Namespace) -> None:
    deploys = _get("/deploys", _load_token())
    if emit(deploys, args.json):
        return
    if not deploys:
        print("no deploys — run `sursumai deploy <model>`")
        return
    hdr = f"{'ID':34} {'STATUS':12} {'RUNTIME':8} {'MODEL':30} ENDPOINT"
    print(hdr)
    print("-" * len(hdr))
    for d in deploys:
        spec = d.get("spec", {})
        print(
            f"{d['id']:34} {d['status']:12} {spec.get('runtime', ''):8} "
            f"{(spec.get('model') or '')[:30]:30} {d.get('endpoint') or ''}"
        )


def cmd_pools(args: argparse.Namespace) -> None:
    pools = _get("/pools", _load_token())
    if emit(pools, args.json):
        return
    if not pools:
        print("no pools — create one in the web UI")
        return
    hdr = f"{'ID':34} {'MODE':12} {'MODELS':7} NAME"
    print(hdr)
    print("-" * len(hdr))
    for p in pools:
        n = len(p.get("model_ids") or [])
        print(f"{p['id']:34} {p.get('mode', ''):12} {n:<7} {p['name']}")


def cmd_keys(args: argparse.Namespace) -> None:
    """Account API keys: one key works for every model you own."""
    token = _load_token()
    if args.revoke:
        _http("DELETE", f"/api-keys/{args.revoke}", token=token)
        ok(f"revoked {args.revoke}")
        return
    if args.create is not None:
        name = args.create or "cli"
        created = _http("POST", "/api-keys", {"name": name}, token)[1]
        ok(f"created '{created['name']}' — copy it now, it is not shown again:")
        print(created["key"])
        return
    keys = _get("/api-keys", token)
    if emit(keys, args.json):
        return
    if not keys:
        print("no API keys — create one with `sursumai keys --create <name>`")
        return
    hdr = f"{'ID':34} {'KEY':24} {'LAST USED':12} NAME"
    print(hdr)
    print("-" * len(hdr))
    for k in keys:
        used = (k.get("last_used_at") or "never")[:10]
        print(f"{k['id']:34} {k['display']:24} {used:12} {k['name']}")


def cmd_deploy(args: argparse.Namespace) -> None:
    token = _load_token()
    model = args.model
    if "/" not in model:
        raise CliError(f"'{model}' is not a model id — use the 'org/name' form, e.g. Qwen/Qwen3-8B")
    runtime = args.runtime or ("llama" if "gguf" in model.lower() else "vllm")
    payload = {
        "model": model,
        "runtime": runtime,
        "gpus": args.gpus,
        "max_model_len": args.max_model_len,
        "max_tokens": args.max_tokens,
    }
    print(f"creating deploy {model} ({runtime})…")
    _, data = _http("POST", "/deploys", payload, token)
    deploy_id = data["id"]
    print(f"id {deploy_id}")
    if args.no_wait:
        print(f"watch it live: {WEB_URL}")
        return
    print(f"watch it live: {WEB_URL}")
    _wait_for_deploy(deploy_id, token, args.timeout)


def _wait_for_deploy(deploy_id: str, token: str, timeout: int) -> None:
    last = ""
    deadline = time.time() + timeout
    while time.time() < deadline:
        d = _get(f"/deploys/{deploy_id}", token)
        status = d.get("status", "")
        stage = d.get("stage")
        line = f"{status} — {stage}" if stage else status
        if line != last:
            print(f"  {line}")
            last = line
        if status == "healthy":
            ok(f"healthy — endpoint: {d.get('endpoint') or '(none)'}")
            print("  call it with your account key: sursumai keys --create")
            return
        if status == "failed":
            raise CliError(f"deploy failed: {d.get('error') or 'unknown reason'}")
        time.sleep(3)
    raise CliError("timed out waiting for the deploy to become healthy — check `sursumai list`")


def cmd_logs(args: argparse.Namespace) -> None:
    token = _load_token()
    deploy = _resolve_deploy(args.deploy_id, token)
    deploy_id = deploy["id"]
    if not args.follow:
        print(_get(f"/deploys/{deploy_id}/logs?tail={args.tail}", token).get("logs", ""))
        return
    seen = ""
    while True:
        content = _get(f"/deploys/{deploy_id}/logs?tail=2000", token).get("logs", "")
        if content.startswith(seen):
            sys.stdout.write(content[len(seen):])
        else:
            sys.stdout.write(content)
        sys.stdout.flush()
        seen = content
        time.sleep(2)


def cmd_chat(args: argparse.Namespace) -> None:
    token = _load_token()
    prompt = " ".join(args.prompt) if args.prompt else input("> ").strip()
    if not prompt:
        raise CliError("nothing to ask")
    body = {"messages": [{"role": "user", "content": prompt}],
            "max_tokens": args.max_tokens}
    if args.target.startswith("pool:") or args.target == "router":
        pool = args.target[5:] if args.target.startswith("pool:") else "router"
        body["model"] = pool
        data = _http("POST", "/v1/chat/completions", body, token, timeout=300.0)[1]
        served = data.get("model", "")
        print(data["choices"][0]["message"].get("content", ""))
        if served:
            print(f"\n— answered by {served}", file=sys.stderr)
        return
    deploy = _resolve_deploy(args.target, token)
    data = _http("POST", f"/deploys/{deploy['id']}/chat", body, token, timeout=300.0)[1]
    print(data["choices"][0]["message"].get("content", ""))


def cmd_destroy(args: argparse.Namespace) -> None:
    token = _load_token()
    deploy = _resolve_deploy(args.deploy_id, token)
    deploy_id = deploy["id"]
    if not args.yes:
        model = (deploy.get("spec") or {}).get("model", "?")
        confirm = input(f"destroy {deploy_id[:12]} ({model})? [y/N] ")
        if confirm.strip().lower() not in ("y", "yes"):
            print("aborted")
            return
    _http("DELETE", f"/deploys/{deploy_id}", token=token)
    ok(f"destroyed {deploy_id}")


# One build for everyone, one place to update from. What Pro adds is not a
# different download: it is fetched by the account that paid for it.
REPO = "Ga0512/SursumAI"
REPO_URL = f"https://github.com/{REPO}"
LATEST_RELEASE_API = f"https://api.github.com/repos/{REPO}/releases/latest"


def _local_version() -> str:
    try:
        return (SURSUMAI_ROOT / "VERSION").read_text().strip() or "?"
    except OSError:
        return "?"


def _latest_tag() -> str:
    """Newest published release tag (vX.Y.Z), or '?' if it cannot be reached."""
    req = urllib.request.Request(
        LATEST_RELEASE_API,
        headers={"Accept": "application/vnd.github+json", "User-Agent": "sursumai"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return (json.load(resp).get("tag_name") or "").strip() or "?"
    except Exception:
        return "?"


def cmd_update(args: argparse.Namespace) -> None:
    current = _local_version()
    tag = args.version or _latest_tag()
    if tag == "?":
        raise CliError("could not reach GitHub to find the latest release")
    if not tag.startswith("v"):
        tag = f"v{tag}"
    print(f"SursumAI {current} -> {tag.lstrip('v')}")
    if not args.yes and tag.lstrip("v") == current:
        print("already up to date")
        return
    if not args.yes:
        confirm = input(f"update to {tag}? [y/N] ")
        if confirm.strip().lower() not in ("y", "yes"):
            print("aborted")
            return
    cmd_stop(args)
    env = {**os.environ, "SURSUMAI_VERSION": tag}
    # the installer comes from the tag being installed, not from a branch
    pipe = f"curl -fsSL {REPO_URL}/raw/{tag}/install.sh | bash"
    print("running installer…")
    result = subprocess.run(["bash", "-c", pipe], env=env)
    if result.returncode != 0:
        raise CliError("the installer failed — SursumAI was left on the current version")
    ok(f"updated to {tag.lstrip('v')}. run `sursumai` to start")


def _stop_models() -> None:
    """Stop every model this machine is running: they outlive `sursumai stop`
    on purpose, so an uninstall that skipped them would leave a GPU busy with
    nothing left to manage it."""
    logs = SURSUMAI_ROOT / "sursumai-logs"
    for pid_file in logs.glob("*.pid") if logs.is_dir() else []:
        try:
            os.kill(int(pid_file.read_text().strip()), 15)
        except (ValueError, OSError):
            pass
    try:
        # the executors name every container deploy-<id>; the image check
        # keeps a stranger's "deploy-…" container out of it
        out = subprocess.run(
            ["docker", "ps", "-a", "--filter", "name=^deploy-", "--format", "{{.ID}} {{.Image}}"],
            capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return
    ids = [line.split()[0] for line in out.splitlines()
           if len(line.split()) == 2 and ("vllm" in line.split()[1] or "llama.cpp" in line.split()[1])]
    if ids:
        subprocess.run(["docker", "rm", "-f", *ids], capture_output=True, timeout=120)


def _uninstall_paths() -> list[Path]:
    home = Path.home()
    paths = [
        home / ".sursumai",                                  # account, Pro module, keys
        Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share") / "sursumai",  # the database
        CONFIG_DIR,                                          # the CLI's login
        home / ".local/bin/sursumai",
        home / ".local/share/icons/sursumai.svg",
        home / ".local/share/applications/sursumai.desktop",
        home / "Applications/SursumAI.app",
        LOG_DIR,
    ]
    if os.environ.get("WSL_DISTRO_NAME"):
        try:
            profile = subprocess.run(["cmd.exe", "/c", "echo %USERPROFILE%"], capture_output=True,
                                     text=True, timeout=15).stdout.strip()
            win = subprocess.run(["wslpath", "-u", profile], capture_output=True,
                                 text=True, timeout=15).stdout.strip()
            if win:
                w = Path(win)
                paths += [w / ".sursumai", w / "Desktop/SursumAI.lnk", w / "Desktop/sursumai.bat"]
        except (OSError, subprocess.TimeoutExpired):
            pass
    # the app itself — unless this is a git checkout someone develops in
    if not (SURSUMAI_ROOT / ".git").exists():
        paths.append(SURSUMAI_ROOT)
    return paths


def cmd_uninstall(args: argparse.Namespace) -> None:
    import shutil

    if not args.yes:
        print("This removes SursumAI from this computer: the app, its database (local")
        print("accounts, deploys, pools, API keys), downloaded models and the Pro sign-in.")
        print("Models running now are stopped. A Pro subscription is NOT cancelled, and")
        print("machines added over SSH are left as they are.")
        if input("type 'uninstall' to confirm: ").strip().lower() != "uninstall":
            print("aborted")
            return
    _stop_models()
    cmd_stop(args)
    for path in _uninstall_paths():
        try:
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(path)
        except OSError as e:
            warn(f"could not remove {path}: {e}")
    ok("SursumAI was removed. To install it again:")
    print(f"  curl -fsSL {REPO_URL}/raw/v{_local_version()}/install.sh | bash"
          if _local_version() != "?" else f"  see {REPO_URL}")


# ---------- main ----------

COMMANDS = {
    "status": cmd_status,
    "restart": cmd_restart,
    "stop": cmd_stop,
    "version": cmd_version,
    "login": cmd_login,
    "whoami": cmd_whoami,
    "logout": cmd_logout,
    "list": cmd_list,
    "pools": cmd_pools,
    "keys": cmd_keys,
    "deploy": cmd_deploy,
    "logs": cmd_logs,
    "chat": cmd_chat,
    "destroy": cmd_destroy,
    "update": cmd_update,
    "uninstall": cmd_uninstall,
    "service": cmd_service,
}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sursumai",
        description="SursumAI — run and manage local model deploys",
    )
    parser.add_argument("--ui", action="store_true",
                        help="start everything and open the browser")
    parser.add_argument("--version", action="version", version=f"sursumai {_local_version()}")
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    def add(name, help_):
        return sub.add_parser(name, help=help_)

    p = add("status", "show running state")
    p.add_argument("--json", action="store_true")
    add("restart", "stop and start the 3 processes")
    add("stop", "stop the 3 processes")
    add("version", "show the installed version")
    add("logout", "remove the stored login")

    p_login = add("login", "store a login token")
    p_login.add_argument("email", nargs="?")
    p_login.add_argument("password", nargs="?")

    p = add("whoami", "show who is logged in")
    p.add_argument("--json", action="store_true")

    p = add("list", "list deploys")
    p.add_argument("--json", action="store_true")

    p = add("pools", "list pools")
    p.add_argument("--json", action="store_true")

    p_keys = add("keys", "list, create or revoke account API keys")
    p_keys.add_argument("--create", nargs="?", const="cli", metavar="NAME",
                        help="mint a key with this name")
    p_keys.add_argument("--revoke", metavar="ID", help="revoke a key by id")
    p_keys.add_argument("--json", action="store_true")

    p_deploy = add("deploy", "create a deploy")
    p_deploy.add_argument("model")
    p_deploy.add_argument("--runtime", choices=["vllm", "llama"], default=None)
    p_deploy.add_argument("--gpus", type=int, default=1)
    p_deploy.add_argument("--max-model-len", type=int, default=300)
    p_deploy.add_argument("--max-tokens", type=int, default=2048)
    p_deploy.add_argument("--timeout", type=int, default=1800)
    p_deploy.add_argument("--no-wait", action="store_true",
                          help="return as soon as the deploy is created")

    p_logs = add("logs", "tail deploy logs")
    p_logs.add_argument("deploy_id")
    p_logs.add_argument("--tail", type=int, default=300)
    p_logs.add_argument("--follow", "-f", action="store_true")

    p_chat = add("chat", "send one message to a deploy or pool")
    p_chat.add_argument("target", help="deploy id, 'pool:<id>' or 'router'")
    p_chat.add_argument("prompt", nargs="*")
    p_chat.add_argument("--max-tokens", type=int, default=512)

    p_destroy = add("destroy", "destroy a deploy")
    p_destroy.add_argument("deploy_id")
    p_destroy.add_argument("--yes", action="store_true")

    p_update = add("update", "update SursumAI to the latest release")
    p_update.add_argument("--yes", action="store_true", help="skip confirmation")
    p_update.add_argument("--version", default=None, help="install a specific tag")

    p = add("uninstall", "remove SursumAI from this computer")
    p.add_argument("--yes", action="store_true", help="skip confirmation")

    p_service = add("service", "keep SursumAI running across crashes and reboots")
    p_service.add_argument("action", nargs="?", default="status",
                           choices=["install", "uninstall", "status"])
    p_service.add_argument("--json", action="store_true")

    return parser


def main() -> None:
    _utf8_output()
    parser = build_parser()
    args = parser.parse_args()

    try:
        if args.command is None or args.ui:
            cmd_launch(args)
            return
        handler = COMMANDS.get(args.command)
        if handler is None:  # argparse already rejects these; belt and braces
            parser.print_help()
            sys.exit(EXIT_USAGE)
        handler(args)
    except CliError as e:
        die(str(e))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(EXIT_OK)


if __name__ == "__main__":
    main()
